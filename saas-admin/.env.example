# ── Database (same as main ERP app) ──────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@localhost:5432/erp

# ── Auth ──────────────────────────────────────────────────────
# Must be different from the main app's JWT_SECRET
ADMIN_JWT_SECRET=change-me-strong-secret-32chars-min

# ── Super Admin Bootstrap ─────────────────────────────────────
# Used ONLY on first run to create the initial super admin account
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change-me-strong-password
INITIAL_ADMIN_NAME=Super Admin
