# ═══════════════════════════════════════════════════
#  NexusERP — Environment Variables
#  Copy this file to .env.local for development
#  Copy to .env.production for production
# ═══════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NexusERP"
NEXT_PUBLIC_APP_URL="https://app.nexuserp.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@nexuserp.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP="966500000000"
NEXT_PUBLIC_APP_VERSION="2.0.0"

# ── Environment ─────────────────────────────────────
NODE_ENV="production"
# NODE_ENV="development"

# ── Next.js ──────────────────────────────────────────
# Secret used to encrypt session cookies (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_32_CHARS"
NEXTAUTH_URL="https://app.nexuserp.com"

# ── Database (for future PostgreSQL migration) ───────
# DATABASE_URL="postgresql://nexus_user:password@localhost:5432/nexus_erp"
# DATABASE_SSL="true"

# ── Redis (for session caching) ──────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Email (for notifications) ────────────────────────
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# SMTP_FROM="noreply@nexuserp.com"

# ── Storage (for file uploads) ───────────────────────
# S3_BUCKET="nexus-erp-uploads"
# S3_REGION="me-south-1"
# AWS_ACCESS_KEY_ID="your-key"
# AWS_SECRET_ACCESS_KEY="your-secret"

# ── Analytics (optional) ────────────────────────────
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ── Super Admin Seed (optional — creates SA on first boot) ──
# SUPER_ADMIN_EMAIL="admin@nexuserp.com"
# SUPER_ADMIN_PASSWORD="CHANGE_THIS_STRONG_PASSWORD"
# SUPER_ADMIN_NAME="مدير النظام"
