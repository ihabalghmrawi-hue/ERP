# ═══════════════════════════════════════════════════════════════
#  BOB ERP — Environment Variables
#  Copy to .env.local for development
#  Add each variable in Vercel Dashboard → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── JWT Authentication (REQUIRED) ───────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="CHANGE_THIS_MIN_32_CHARS_RANDOM_STRING"
JWT_REFRESH_SECRET="CHANGE_THIS_DIFFERENT_MIN_32_CHARS_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Database — PostgreSQL (REQUIRED) ────────────────────────────
# Vercel Postgres: copy from Storage → your_db → .env.local
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Setup Secret (REQUIRED on first deploy) ─────────────────────
# One-time secret to create the first Super Admin via POST /api/setup
# Generate with: openssl rand -hex 24
# After creating the Super Admin, you can remove this variable.
SETUP_SECRET="CHANGE_THIS_RANDOM_SECRET"

# ── Redis / KV Store (OPTIONAL) ─────────────────────────────────
# Upstash Redis — faster session caching.
# Without this, the app stores data in JSON files (works on Vercel but resets on redeploy).
# Vercel KV: copy from Storage → your_kv → .env.local
KV_REST_API_URL="https://CHANGE.upstash.io"
KV_REST_API_TOKEN="CHANGE_THIS_UPSTASH_TOKEN"

# ── Next.js (REQUIRED) ──────────────────────────────────────────
NEXTAUTH_SECRET="SAME_OR_DIFFERENT_FROM_JWT_SECRET_MIN_32"
NEXTAUTH_URL="https://your-app.vercel.app"
